meta {
  name: modify rosters
  type: http
  seq: 2
}

put {
  url: {{host}}/api/roster/update
  body: json
  auth: inherit
}

body:json {
  [
    {
      "id": 101,
      "playerId": 48,
      "teamId": 7,
      "seasonYear": 2026,
      "draftPosition": "D_A2",
      "position": "DEFENCE",
      "jerseyNumber": 55,
      "firstName": "Chad",
      "lastName": "Springer",
      "fullName": "Chad Springer",
      "teamName": "Flames",
      "rookie": false,
      "active": true
    }
  ]
}

body:multipart-form {
  file: @file()
}

settings {
  encodeUrl: true
  timeout: 0
}
