meta {
  name: modify rosters
  type: http
  seq: 2
}

put {
  url: {{host}}/api/roster/update
  body: json
  auth: inherit
}

body:json {
  [
    {
      "id": 113,
      "playerId": 93,
      "teamId": 8,
      "seasonYear": 2026,
      "draftPosition": "D_B2",
      "position": "DEFENCE",
      "jerseyNumber": 0,
      "firstName": "Jordan",
      "lastName": "McArthur",
      "fullName": "Jordan McArthur",
      "teamName": "Habs",
      "rookie": true,
      "active": true
    }
  ]
}

body:multipart-form {
  file: @file()
}

settings {
  encodeUrl: true
  timeout: 0
}
