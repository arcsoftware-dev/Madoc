meta {
  name: modify rosters
  type: http
  seq: 2
}

put {
  url: {{host}}/api/roster/update
  body: json
  auth: inherit
}

body:json {
  [
    {
      "id": 177,
      "playerId": 4,
      "teamId": 10,
      "seasonYear": 2026,
      "draftPosition": "G",
      "position": "GOALIE",
      "jerseyNumber": 29,
      "firstName": "Chris",
      "lastName": "Gedney",
      "fullName": "Chris Gedney",
      "teamName": "Canucks",
      "rookie": false,
      "active": false
    }
  ]
}

body:multipart-form {
  file: @file()
}

settings {
  encodeUrl: true
  timeout: 0
}
