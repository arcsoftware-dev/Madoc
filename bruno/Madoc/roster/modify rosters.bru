meta {
  name: modify rosters
  type: http
  seq: 2
}

put {
  url: {{host}}/api/roster/update
  body: json
  auth: inherit
}

body:json {
  [
    {
      "id": 153,
      "playerId": 84,
      "teamId": 12,
      "seasonYear": 2026,
      "draftPosition": "F_B3",
      "position": "FORWARD",
      "jerseyNumber": 57,
      "firstName": "Danny",
      "lastName": "Ryan",
      "fullName": "Danny Ryan",
      "teamName": "Oilers",
      "rookie": false,
      "active": true
    }
  ]
}

body:multipart-form {
  file: @file()
}

settings {
  encodeUrl: true
  timeout: 0
}
