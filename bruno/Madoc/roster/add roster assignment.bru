meta {
  name: add roster assignment
  type: http
  seq: 5
}

post {
  url: {{host}}/api/roster/create/assignment
  body: json
  auth: inherit
}

body:json {
  {
    "playerId": 107,
    "teamId": 8,
    "seasonYear": 2026,
    "draftPosition": "F_C3",
    "position": "FORWARD",
    "jerseyNumber": 6,
    "firstName": "Luke",
    "lastName": "Palmeiro",
    "teamName": "Habs",
    "active": true,
    "rookie": false
  }
}

body:multipart-form {
  file: @file()
}

settings {
  encodeUrl: true
  timeout: 0
}
