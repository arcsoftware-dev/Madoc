    "lastName": "Meissner",
    "fullName": "Kevin Meissner",
    "teamName": "Flames",
    "active": true,
    "rookie": false
  }
}

body:multipart-form {
  file: @file()
}

settings {
  encodeUrl: true
  timeout: 0
}
