meta {
  name: add roster assignment
  type: http
  seq: 5
}

post {
  url: {{host}}/api/roster/create/assignment
  body: json
  auth: inherit
}

body:json {
  {
    "playerId": 90,
    "teamId": 9,
    "seasonYear": 2026,
    "draftPosition": "D_B2",
    "position": "DEFENCE",
    "jerseyNumber": 0,
    "firstName": "Jake",
    "lastName": "Wong",
    "fullName": "Jake Wong",
    "teamName": "Jets",
    "active": true,
    "rookie": false
  }
}

body:multipart-form {
  file: @file()
}

settings {
  encodeUrl: true
  timeout: 0
}
