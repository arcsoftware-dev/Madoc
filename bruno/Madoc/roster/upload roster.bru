meta {
  name: upload roster
  type: http
  seq: 1
}

post {
  url: {{host}}/api/roster/upload
  body: multipartForm
  auth: inherit
}

body:multipart-form {
  file: @file(/home/jake/dev/projects/Madoc/src/main/resources/data/rosters/2026.csv)
  year: {{year}}
}

vars:pre-request {
  year: 2026
}

settings {
  encodeUrl: true
  timeout: 0
}
