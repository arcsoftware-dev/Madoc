meta {
  name: upload schedule
  type: http
  seq: 1
}

post {
  url: {{host}}/api/schedule/upload
  body: multipartForm
  auth: inherit
}

body:multipart-form {
  file: @file(/home/jake/dev/projects/Madoc/src/main/resources/data/schedule/2026/Madoc2026RegularSeasonSchedule.csv) @contentType(text/csv; charset=utf-8)
  year: {{year}}
  season-type: {{seasonType}}
}

vars:pre-request {
  year: 2026
  seasonType: REGULAR_SEASON
}

settings {
  encodeUrl: true
  timeout: 0
}
